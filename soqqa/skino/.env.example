# ============================================================================
# BLAZZER — server environment
# Copy to `.env` and fill in. Never commit `.env` (it is git-ignored).
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
TRUST_PROXY=true

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret for internal drop ingestion (game services -> live feed).
# REQUIRED in production.
LIVE_SERVICE_KEY=

# --- Provably fair (Stage 2) -----------------------------------------------
# AES-256-GCM key that encrypts server seeds at rest: 32 bytes as 64 hex chars
# or base64. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development a stable key is derived from JWT_SECRET automatically.
FAIR_ENCRYPTION_KEY=

# Comma-separated list of allowed browser origins for the REST API.
# Leave empty when the API and site share an origin (the default in dev).
CORS_ORIGINS=

# --- Data stores -----------------------------------------------------------
# Optional. Without Redis the feed falls back to an in-process ring buffer.
REDIS_URL=
# Example: redis://:password@127.0.0.1:6379

# Optional. Enables daily aggregates in Postgres via Prisma.
DATABASE_ENABLED=false
DATABASE_URL=
# Example: postgresql://blazzer:secret@127.0.0.1:5432/blazzer?schema=public

# --- Live feed tuning ------------------------------------------------------
LIVE_KEEP_LAST=500
LIVE_RETENTION_MS=86400000
LIVE_CLEANUP_MS=900000
LIVE_BIG_WIN=10000
LIVE_HUGE_WIN=100000
LIVE_MERGE_MS=2000
# Demo-only baseline added to the real connection count (set 0 for real numbers).
LIVE_ONLINE_BASE=0
# Comma-separated user ids to keep out of the public feed (bots/demo accounts).
LIVE_EXCLUDED_USERS=

# --- Upgrade (Stage 3.4) ---------------------------------------------------
# The house edge and the odds band are deliberately NOT environment variables:
# they live in js/upgrade-rules.js, which the server imports directly, so a
# player is shown exactly the odds they are settled against. Only the rate
# budgets are tunable here.
UPGRADE_RATE_WINDOW_MS=3600000
UPGRADE_RATE_PLAY=120
UPGRADE_RATE_READ=240

# --- Rate limits -----------------------------------------------------------
RATE_WINDOW_MS=60000
RATE_API_MAX=120
RATE_TOKEN_MAX=30
RATE_INGEST_MAX=240

# --- Simulator (server/scripts/simulate.js) --------------------------------
SIM_URL=
SIM_RATE=100
